# wedding-card-invitation-web — environment variables (example only, never commit real values)
#
# These are read by serverless.yml at deploy time, by scripts at runtime, and
# by the frontend at build time. Set every value for the stage you deploy to.
#
# Note: wedding-card-invitation-web / wedding-card-invitation-web placeholders are renamed to your project name by
# scripts/scaffold-project.sh (e.g. my-app -> my-app-{stage}-db-credentials).

## Backend deploy env (set at `serverless deploy` time)

# Secrets Manager secret name holding the RDS credentials
# {"host","port","username","password","dbname"} — never hardcode credentials.
GETDB_CONNECTION=wedding-card-invitation-web-{stage}-db-credentials

# Cognito user pool (created by Terraform — see infra/terraform/cognito.tf)
COGNITO_USER_POOL_ID=<user-pool-id>
COGNITO_APP_CLIENT_ID=<app-client-id>
COGNITO_DOMAIN=wedding-card-invitation-web-auth-{stage}
COGNITO_USER_POOL_ARN=arn:aws:cognito-idp:<region>:<account-id>:userpool/<user-pool-id>

# S3 buckets (created by Terraform)
RECEIPTS_BUCKET=wedding-card-invitation-web-{stage}-receipts
ASSETS_BUCKET=wedding-card-invitation-web-{stage}-assets
# CloudFront domain serving the assets bucket (used as the CDN domain for image
# uploads — the browser PUTs to ASSETS_BUCKET via a presigned URL, then the
# returned cdnUrl is {ASSETS_CDN_URL}/{key}).
ASSETS_CDN_URL=<cdn-domain>

# SES sender + admin notifications
SES_SOURCE=noreply@<your-domain>.com
ADMIN_NOTIFY_EMAIL=<admin@your-domain.com>

# Frontend URL (CORS / callbacks) and public API base
FRONTEND_URL=https://<your-frontend-domain>
API_BASE_URL=<api-base-url>

# Sender identity printed on receipts / notifications
SENDER_NAME=<Your Business Name>
SENDER_PHONE=<phone>
SENDER_ADDRESS=<address>

# ToyyibPay payment gateway (sandbox by default; see services/weddings-service/weddings_module/toyyibpay.py)
TOYYIBPAY_BASE_URL=https://dev.toyyibpay.com
TOYYIBPAY_USER_SECRET_KEY=<toyyibpay-user-secret-key>
TOYYIBPAY_CATEGORY_CODE=<toyyibpay-category-code>

# Public API base URL — used to build the absolute ToyyibPay callback URL
# (PUBLIC_API_BASE_URL + /internal/toyyibpay/callback)
PUBLIC_API_BASE_URL=<api-base-url>

# Shared API key protecting the /internal/* endpoints (Amplify build pipeline)
INTERNAL_API_KEY=<internal-api-key>

# Amplify build-on-demand — triggered after payment (A1). AMPLIFY_APP_ID is the
# Amplify app id; AMPLIFY_BRANCH is the branch to build (default main).
AMPLIFY_APP_ID=<amplify-app-id>
AMPLIFY_BRANCH=main

# Optional explicit URLs for the build pipeline's internal calls. When unset,
# the sync script derives them from NEXT_PUBLIC_API_BASE_URL.
INTERNAL_CONFIGS_URL=<api-base-url>/internal/couples-configs
INTERNAL_BUILD_COMPLETE_URL=<api-base-url>/internal/build-complete

## Shared layer ARN (bump after each layer deploy — see docs/sop.md step 4)
WEDDING_CARD_INVITATION_WEB_COMMON_LAYER_ARN=arn:aws:lambda:<region>:<account-id>:layer:wedding-card-invitation-web-common:<version>

## Frontend build env (set in Amplify console)
NEXT_PUBLIC_API_BASE_URL=<api-base-url>
NEXT_PUBLIC_SITE_URL=https://<your-frontend-domain>
NEXT_PUBLIC_COGNITO_DOMAIN=wedding-card-invitation-web-auth-{stage}
NEXT_PUBLIC_COGNITO_CLIENT_ID=<app-client-id>
NEXT_PUBLIC_COGNITO_REGION=ap-southeast-1
NEXT_PUBLIC_USE_MOCK=false
NEXT_PUBLIC_GA_MEASUREMENT_ID=<ga-measurement-id>
